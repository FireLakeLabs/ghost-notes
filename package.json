{
  "name": "ghost-notes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "vite --port 0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts *.ts",
    "format:check": "prettier --check .",
    "test": "node scripts/node-tests.mjs",
    "test:browser": "node scripts/browser.mjs",
    "check:docs": "node scripts/docs.mjs",
    "check:boundaries": "node scripts/boundaries.mjs",
    "check": "npm run format:check && npm run check:skills && npm run lint && npm run typecheck && npm test && npm run check:docs && npm run check:boundaries && npm run build",
    "test:browser:online": "node scripts/browser.mjs online",
    "measure:edit": "node scripts/browser.mjs measure",
    "shots:editors": "ODM_EDITOR_SHOTS=1 playwright test tests/browser/shots.spec.ts --project=optional --workers=1 --output=.browser-build-shots-results",
    "check:skills": "node scripts/check-skills.mts && node --test scripts/check-skills.test.mts",
    "measure:timeline": "node scripts/browser.mjs timeline-measure"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/web": "1.3.0",
    "@strudel/webaudio": "1.3.0",
    "acorn": "8.19.0",
    "midi-file": "1.2.4",
    "superdough": "1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/estree": "1.0.10",
    "@types/node": "24.19.2",
    "oxc-parser": "0.158.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
